    {
      "name": "Properties",
      "item": [
        {
          "name": "Public Search + Range Filters + Sort",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Properties list 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length > 0) {",
                  "  pm.environment.set('samplePropertyId', json.data[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/properties?minRent=15000&maxRent=75000&minBedrooms=2&sort=rent_asc&page=1&limit=12"
          }
        },
        {
          "name": "Get Property By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Property detail 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/properties/{{samplePropertyId}}"
          }
        },
        {
          "name": "Owner My Listings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Owner listings 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": "{{baseUrl}}/properties/mine"
          }
        },
        {
          "name": "Create Property",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created property 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "  pm.environment.set('createdPropertyId', json.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bright 2BHK Apartment in Saket\",\n  \"description\": \"Spacious 2BHK unit with balcony, modular kitchen, and reserved parking near Saket Metro.\",\n  \"rent\": 35000,\n  \"deposit\": 70000,\n  \"bedrooms\": 2,\n  \"bathrooms\": 2,\n  \"areaSqFt\": 1180,\n  \"propertyType\": \"apartment\",\n  \"location\": {\n    \"area\": \"Saket\",\n    \"city\": \"Delhi\",\n    \"address\": \"B-21, Saket\",\n    \"pincode\": \"110017\"\n  },\n  \"amenities\": [\"Parking\", \"AC\", \"Lift\"],\n  \"images\": [\"https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=1200&q=80\"]\n}"
            },
            "url": "{{baseUrl}}/properties"
          }
        },
        {
          "name": "Update Property",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Updated property 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rent\": 36500,\n  \"amenities\": [\"Parking\", \"AC\", \"Lift\", \"Power Backup\"]\n}"
            },
            "url": "{{baseUrl}}/properties/{{createdPropertyId}}"
          }
        },
        {
          "name": "Delete Property",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deleted property 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": "{{baseUrl}}/properties/{{createdPropertyId}}"
          }
        }
      ]
