{
  "info": {
    "name": "RentEasy API Collection",
    "description": "Complete RentEasy MERN API collection covering Auth, Properties, Saved Properties, Enquiries & Visit Requests, and Admin Moderation & Analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
